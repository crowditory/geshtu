{
  "name": "geshtu-admin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync || echo \"\"",
    "serve": "sirv-cli build --port ${PORT:-8501} --host 0.0.0.0 --single --quiet"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.5",
    "@sveltejs/kit": "^2.7.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.13",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.453.0",
    "sirv-cli": "^3.0.0",
    "tailwind-merge": "^2.5.4"
  }
}
