# ─── Database ────────────────────────────────────────────────
POSTGRES_DB=geshtu
POSTGRES_USER=geshtu
POSTGRES_PASSWORD=change-me-to-a-strong-random-string

# ─── Auth ────────────────────────────────────────────────────
# 32-byte random hex; generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-bytes-random-hex

# ─── Anthropic ───────────────────────────────────────────────
# Required: get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Models. Override only if you know what you're doing.
EXTRACTION_MODEL=claude-haiku-4-5
DIGEST_MODEL=claude-sonnet-4-6

# ─── Embeddings (local, CPU) ─────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3

# ─── Public surface ──────────────────────────────────────────
# When deploying with Caddy/TLS, set this to your real hostname.
# (Then run:  docker compose --profile tls up -d)
PUBLIC_HOSTNAME=localhost

# Email for Let's Encrypt expiry notifications. Optional but recommended.
ACME_EMAIL=you@example.com

# Ports exposed on the host
MCP_PORT=3000
ADMIN_PORT=8501

# Who can reach the admin UI directly. Default (0.0.0.0) is fine for laptop
# development or trusted private networks. Set to 127.0.0.1 in production
# when Caddy terminates TLS in front and exposes admin via HTTPS.
ADMIN_BIND=0.0.0.0

# ─── Privacy / retention ─────────────────────────────────────
# 0 = retain forever. Otherwise messages older than N days are zeroed.
MESSAGES_RETENTION_DAYS=0

# ─── Telemetry (off by default) ──────────────────────────────
# Set to "on" to send anonymous version+platform pings on startup.
GESHTU_TELEMETRY=off

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
