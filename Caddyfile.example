# Caddyfile for Geshtu. Copy to ./Caddyfile and run:
#   docker compose --profile tls up -d
#
# Domain + ACME email come from .env (PUBLIC_HOSTNAME, ACME_EMAIL).

{
    # Optional but recommended: an email gives you Let's Encrypt expiry
    # warnings and slightly higher rate limits on cert issuance.
    email {$ACME_EMAIL}
}

{$PUBLIC_HOSTNAME} {
    encode gzip

    # API: strip the /api prefix so /api/health → /health on the upstream.
    # MCP clients should set API_URL=https://{hostname}/api in their config.
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:8000
    }

    # Default: SvelteKit admin SPA at the root. The container runs sirv-cli
    # in --single mode, so any deep-link URL (e.g. /tokens) is served from
    # index.html and the client-side router handles the actual routing.
    handle {
        reverse_proxy admin:8501
    }
}
